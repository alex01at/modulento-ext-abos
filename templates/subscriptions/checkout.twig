{% extends 'layout/base.twig' %}

{% block title %}{{ trans('abos.checkout.title') }} – {{ site_name }}{% endblock %}

{% block content %}
{% include 'account/_nav.twig' %}
<h1>{{ trans('abos.checkout.title') }}</h1>
<p><strong>{{ plan.name }}</strong> · {{ money(plan.price_cents, plan.currency) }}{% if plan.per_seat %} {{ trans('abos.checkout.per_seat') }}{% endif %} <small>{{ trans(plan.period_months == 1 ? 'abos.period_one' : 'abos.period', {count: plan.period_months}) }}</small></p>

{% if not methods.transfer and not methods.stripe %}
    <p>{{ trans('abos.checkout.none') }}</p>
{% else %}
    <form method="post" action="{{ url('/subscriptions/' ~ plan.id ~ '/checkout') }}" class="stack-form">
        {{ csrf_field() }}
        {% if plan.per_seat %}
            <label for="checkout-quantity">{{ trans('abos.checkout.quantity') }}</label>
            <input id="checkout-quantity" name="quantity" type="number" min="{{ plan.min_quantity }}" value="{{ plan.min_quantity }}" required>
            <small>{{ trans('abos.checkout.quantity_hint', {min: plan.min_quantity}) }}</small>
        {% endif %}
        <h2>{{ trans('abos.checkout.address') }}</h2>
        <p><small>{{ trans('abos.checkout.address_hint') }}</small></p>
        <label for="billing-name">{{ trans('abos.checkout.name') }}</label>
        <input id="billing-name" name="name" value="{{ address.name ?? '' }}" maxlength="150" autocomplete="name" required>
        <label for="billing-street">{{ trans('abos.checkout.street') }}</label>
        <input id="billing-street" name="street" value="{{ address.street ?? '' }}" maxlength="200" autocomplete="street-address" required>
        <label for="billing-postal">{{ trans('abos.checkout.postal_code') }}</label>
        <input id="billing-postal" name="postal_code" value="{{ address.postal_code ?? '' }}" maxlength="20" autocomplete="postal-code" required>
        <label for="billing-city">{{ trans('abos.checkout.city') }}</label>
        <input id="billing-city" name="city" value="{{ address.city ?? '' }}" maxlength="100" autocomplete="address-level2" required>
        <label for="billing-country">{{ trans('abos.checkout.country') }}</label>
        <select id="billing-country" name="country" required>
            {% for code in countries %}
                <option value="{{ code }}" {{ code == (address.country ?? 'DE') ? 'selected' }}>{{ trans('core.country.' ~ code) }}</option>
            {% endfor %}
        </select>

        <div class="button-row">
            {% if methods.transfer %}<button type="submit" name="method" value="transfer">{{ trans('abos.buy.transfer') }}</button>{% endif %}
            {% if methods.stripe %}<button type="submit" name="method" value="stripe">{{ trans('abos.buy.stripe') }}</button>{% endif %}
        </div>
    </form>
{% endif %}
{% endblock %}
