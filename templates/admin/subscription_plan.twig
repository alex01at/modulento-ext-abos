{% extends '@admin/layout.twig' %}

{% block title %}{{ plan.name }} – {{ trans('abos.admin.title') }} – {{ site_name }}{% endblock %}

{% block admin %}
{% include '@admin/_page_header.twig' with {heading: plan.name, crumbs: [{label: trans('abos.admin.title'), path: '/admin/subscriptions'}]} only %}

<div class="split">
<section class="card-box">
    <div class="card-head">
        <p>{{ trans('abos.admin.plan.intro') }}</p>
        <p><small>{{ trans('abos.admin.plans.form.slug') }}: <code>{{ plan.slug }}</code></small></p>
    </div>
    <form method="post" action="{{ url('/admin/subscriptions/plans/' ~ plan.id) }}" class="stack-form" id="plan-form">
        {{ csrf_field() }}
        <label for="plan-name">{{ trans('abos.admin.plans.form.name') }}</label>
        <input id="plan-name" name="name" value="{{ plan.name }}" maxlength="100" required>
        <label for="plan-app">{{ trans('abos.admin.plans.form.app') }}</label>
        <select id="plan-app" name="app_id">
            <option value="" {{ plan.app_id is null ? 'selected' }}>{{ trans('abos.admin.plans.app_general') }}</option>
            {% for id, name in apps %}
                <option value="{{ id }}" {{ id == plan.app_id ? 'selected' }}>{{ name }}</option>
            {% endfor %}
        </select>
        <small>{{ trans('abos.admin.plans.form.app_hint') }}</small>
        <label for="plan-price">{{ trans('abos.admin.plans.form.price') }}</label>
        <input id="plan-price" name="price" value="{{ price }}" inputmode="decimal" required>
        <label for="plan-currency">{{ trans('abos.admin.plans.form.currency') }}</label>
        <input id="plan-currency" name="currency" value="{{ plan.currency }}" maxlength="3" pattern="[A-Za-z]{3}" required>
        <label for="plan-period">{{ trans('abos.admin.plans.form.period') }}</label>
        <select id="plan-period" name="period_months">
            {% for months in periods %}
                <option value="{{ months }}" data-label="{{ trans(months == 1 ? 'abos.admin.plans.months_one' : 'abos.admin.plans.months', {count: months}) }}" {{ months == plan.period_months ? 'selected' }}>{{ trans(months == 1 ? 'abos.admin.plans.months_one' : 'abos.admin.plans.months', {count: months}) }}</option>
            {% endfor %}
        </select>

        <fieldset>
            <legend>{{ trans('abos.admin.plan.features') }}</legend>
            {% if features is empty %}
                <p><small>{{ trans('abos.admin.plan.no_features') }}</small></p>
            {% endif %}
            {% for feature in features %}
                <label class="checkbox">
                    <input type="checkbox" name="features[]" value="{{ feature.key }}" data-label="{{ trans(feature.label_key) }}" {{ feature.key in plan.features ? 'checked' }}>
                    <span>{{ trans(feature.label_key) }} <small>{{ feature.key }}</small></span>
                </label>
            {% endfor %}

            <label for="plan-custom-0">{{ trans('abos.admin.plan.custom_features') }}</label>
            <small>{{ trans('abos.admin.plan.custom_features_hint') }}</small>
            {% for key in custom_features %}
                <input id="plan-custom-{{ loop.index0 }}" class="custom-feature" name="custom_features[]" value="{{ key }}" maxlength="60" pattern="[a-z0-9._-]+">
            {% endfor %}
            {% for i in 1..3 %}
                <input id="plan-custom-{{ custom_features|length + loop.index0 }}" class="custom-feature" name="custom_features[]" placeholder="visitenkarte.logo" maxlength="60" pattern="[a-z0-9._-]+">
            {% endfor %}
        </fieldset>

        <fieldset>
            <legend>{{ trans('abos.admin.plan.limits') }}</legend>
            <p><small>{{ trans('abos.admin.plan.limits_hint') }}</small></p>
            {% for type in offer_types %}
                <label for="plan-limit-{{ type.id }}">{{ trans(type.label_key) }}</label>
                <input id="plan-limit-{{ type.id }}" name="offer_limits[{{ type.id }}]" type="number" min="0" data-label="{{ trans(type.label_key) }}" value="{{ plan.offer_limits[type.id] ?? '' }}">
            {% endfor %}
            <label for="plan-max-images">{{ trans('abos.admin.plan.max_images') }}</label>
            <input id="plan-max-images" name="max_images_per_offer" type="number" min="0" value="{{ plan.max_images_per_offer ?? '' }}">
        </fieldset>

        <fieldset>
            <legend>{{ trans('abos.admin.plan.seats') }}</legend>
            <p><small>{{ trans('abos.admin.plan.seats_hint') }}</small></p>
            <label class="checkbox">
                <input type="checkbox" name="per_seat" value="1" {{ plan.per_seat ? 'checked' }}>
                <span>{{ trans('abos.admin.plan.per_seat') }}</span>
            </label>
            <label for="plan-min-quantity">{{ trans('abos.admin.plan.min_quantity') }}</label>
            <input id="plan-min-quantity" name="min_quantity" type="number" min="1" value="{{ plan.min_quantity }}">
        </fieldset>

        <label class="checkbox">
            <input type="checkbox" name="active" value="1" {{ plan.active ? 'checked' }}>
            <span>{{ trans('abos.admin.plan.active') }}</span>
        </label>
        <small>{{ trans('abos.admin.plan.active_hint') }}</small>
        <button type="submit">{{ trans('abos.admin.plan.save') }}</button>
    </form>
</section>

<aside class="card-box plan-preview" aria-live="polite">
    <div class="card-head">
        <h2>{{ trans('abos.admin.plan.preview') }}</h2>
    </div>
    <p><small>{{ trans('abos.admin.plan.preview_hint') }}</small></p>
    <div class="plan-card">
        <div class="card-head">
            <strong class="card-title" id="preview-name" data-placeholder="{{ trans('abos.admin.plan.preview_unnamed') }}"></strong>
            <span class="badge" id="preview-badge" data-active="{{ trans('abos.admin.plans.active_badge') }}" data-inactive="{{ trans('abos.admin.plans.inactive') }}"></span>
        </div>
        <p class="price" id="preview-price"></p>
        <ul id="preview-features" class="plan-preview-list" data-none-label="{{ trans('abos.admin.plan.preview_empty') }}" data-images-label="{{ trans('abos.admin.plan.preview_images') }}"></ul>
    </div>
</aside>
</div>

<section class="card-box">
    <h2>{{ trans('abos.admin.plan.delete.title') }}</h2>
    <p>{{ trans('abos.admin.plan.delete.intro') }}</p>
    <form method="post" action="{{ url('/admin/subscriptions/plans/' ~ plan.id ~ '/delete') }}">
        {{ csrf_field() }}
        <button type="submit" class="danger">{{ trans('abos.admin.plan.delete.submit') }}</button>
    </form>
</section>
{% endblock %}
